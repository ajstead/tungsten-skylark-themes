{
  "name": "tungsten-skylark",
  "version": "0.1.0",
  "source": "TungstenSkylark Studios Ltd brand — ts-brand.css (companion to TS-Brand.md v1.0 and TS-Themes.md v0.1)",
  "license_note": "Colours are factual brand values and freely reusable within TungstenSkylark projects. Fonts (Chakra Petch, Space Mono) are SIL OFL — see brand repo.",
  "accent_discipline": "~10% maximum amber/gold per screen; themes are pure variable swaps (no layout/type/behaviour changes)",
  "roles": ["bg", "surface", "text", "accent", "accent_soft", "ink"],
  "role_notes": {
    "bg": "page background",
    "surface": "cards, menus, raised panels",
    "text": "primary text (on bg)",
    "accent": "primary accent / CTAs",
    "accent_soft": "soft accent, glows, highlights",
    "ink": "label colour ON accent (button text)"
  },
  "typography": {
    "font_display": "'Chakra Petch', 'Avenir Next', 'Segoe UI', sans-serif",
    "font_mono": "'Space Mono', ui-monospace, 'SF Mono', Menlo, monospace"
  },
  "layout": {
    "spacing": { "sp_1": 8, "sp_2": 16, "sp_3": 24, "sp_4": 32, "sp_5": 48, "sp_6": 64, "sp_7": 96 },
    "content_max": 1160,
    "radius": 12
  },
  "derived_recipes": {
    "text_soft": "color-mix(in srgb, text 62%, transparent)",
    "line": "color-mix(in srgb, text 16%, transparent)",
    "line_strong": "color-mix(in srgb, text 30%, transparent)",
    "glow": "color-mix(in srgb, accent_soft 24%, transparent)",
    "glow_strong": "color-mix(in srgb, accent_soft 42%, transparent)"
  },
  "accent_text_ruling": "Brand sign-off 2026-11 (@tungsten-skylark-studios, relayed via @ai): --ts-accent-text is a DERIVED role for text-bearing amber. Do NOT override --ts-accent (brand ambers stay decorative: borders, glows). #B26300 is large-text-only (>=18.7px bold / 24px, 3:1); body-size text uses accent_text. A theme's accent_text.light/dark may be an explicit sanctioned value or generated (WCAG-safe blend toward white/black).",
  "themes": [
    {
      "id": "skylark", "label": "Skylark", "note": "the brand base (default)",
      "accent_text": { "light": "#9A5300", "dark": "#FFB24D" },
      "light": { "bg": "#F5F2EC", "surface": "#FFF9F0", "text": "#3C3F44", "accent": "#FFA42B", "accent_soft": "#FFC968", "ink": "#232529" },
      "dark":  { "bg": "#232529", "surface": "#3C3F44", "text": "#F5F2EC", "accent": "#FFB24D", "accent_soft": "#FFC968", "ink": "#232529" }
    },
    {
      "id": "ember", "label": "Ember", "note": "forge red — power",
      "light": { "bg": "#F7F2ED", "surface": "#FFFAF2", "text": "#3A332F", "accent": "#E4562D", "accent_soft": "#FF8B5E", "ink": "#FFFFFF" },
      "dark":  { "bg": "#211C19", "surface": "#362E29", "text": "#F6EFE8", "accent": "#FF7A4E", "accent_soft": "#FFA277", "ink": "#211C19" }
    },
    {
      "id": "dawn", "label": "Dawn", "note": "first light — distinctive",
      "light": { "bg": "#EDF1F6", "surface": "#F8FAFD", "text": "#2D3340", "accent": "#EE6C48", "accent_soft": "#F9A887", "ink": "#FFFFFF" },
      "dark":  { "bg": "#1C222C", "surface": "#2C3442", "text": "#EDF1F7", "accent": "#FF8F68", "accent_soft": "#FFB695", "ink": "#1C222C" }
    },
    {
      "id": "frost", "label": "Frost", "note": "winter on the fells — focus",
      "light": { "bg": "#EFF3F6", "surface": "#F9FBFD", "text": "#2A3138", "accent": "#3F8EC9", "accent_soft": "#7CB6DE", "ink": "#FFFFFF" },
      "dark":  { "bg": "#1B2127", "surface": "#2A323A", "text": "#E8EEF3", "accent": "#5AA5DE", "accent_soft": "#8FC6EC", "ink": "#FFFFFF" }
    },
    {
      "id": "harbour", "label": "Harbour", "note": "working water — steady",
      "light": { "bg": "#ECF3F3", "surface": "#F7FCFC", "text": "#293534", "accent": "#187D80", "accent_soft": "#5DB2B3", "ink": "#FFFFFF" },
      "dark":  { "bg": "#1A2323", "surface": "#293433", "text": "#E9F1F0", "accent": "#33A3A5", "accent_soft": "#66BFBF", "ink": "#FFFFFF" }
    },
    {
      "id": "meadow", "label": "Meadow", "note": "grassland — daylight",
      "light": { "bg": "#F1F4EC", "surface": "#FBFDF7", "text": "#32372D", "accent": "#5C9C38", "accent_soft": "#94C468", "ink": "#FFFFFF" },
      "dark":  { "bg": "#1F231C", "surface": "#2E3529", "text": "#EFF3E7", "accent": "#76BE51", "accent_soft": "#A3D67E", "ink": "#FFFFFF" }
    },
    {
      "id": "dusk", "label": "Dusk", "note": "the descent — nocturnal",
      "light": { "bg": "#F1EFF5", "surface": "#FBF9FD", "text": "#343040", "accent": "#8A55C8", "accent_soft": "#B489DE", "ink": "#FFFFFF" },
      "dark":  { "bg": "#201D27", "surface": "#312C3B", "text": "#EFEBF5", "accent": "#9C6BD8", "accent_soft": "#BE93E6", "ink": "#FFFFFF" }
    },
    {
      "id": "rose", "label": "Rose", "note": "the human side of the metal",
      "light": { "bg": "#F6F0EF", "surface": "#FDF8F7", "text": "#3C3130", "accent": "#CC4758", "accent_soft": "#EF8B97", "ink": "#FFFFFF" },
      "dark":  { "bg": "#231E1E", "surface": "#352E2E", "text": "#F6F0EF", "accent": "#E86577", "accent_soft": "#F2939F", "ink": "#FFFFFF" }
    },
    {
      "id": "ink", "label": "Ink", "note": "pure tungsten — calm",
      "light": { "bg": "#F4F4F3", "surface": "#FCFCFC", "text": "#2F2F2E", "accent": "#6B6E75", "accent_soft": "#9A9DA3", "ink": "#FFFFFF" },
      "dark":  { "bg": "#1D1E20", "surface": "#2D2F33", "text": "#ECECEC", "accent": "#B5B8BE", "accent_soft": "#D6D8DC", "ink": "#2F2F2E" }
    }
  ]
}
