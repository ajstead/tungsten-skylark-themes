{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "TungstenSkylark Studios Ltd brand tokens \u2014 colours, typography and spacing for the theme pack and other apps. W3C Design Tokens (DTCG) format; themes are pure variable swaps (no layout/type/behaviour changes).",
  "$extensions": {
    "com.tungstenskylark.source": "ts-brand.css (companion to TS-Brand.md v1.0 and TS-Themes.md v0.1); Tungsten Matrix special edition 2026-11",
    "com.tungstenskylark.license": "Colours are factual brand values and freely reusable within TungstenSkylark projects. Fonts (Chakra Petch, Space Mono) are SIL OFL \u2014 see brand repo.",
    "com.tungstenskylark.accentDiscipline": "~10% maximum accent colour per screen",
    "com.tungstenskylark.derivedRecipes": {
      "textSoft": "color-mix(in srgb, text 62%, transparent)",
      "line": "color-mix(in srgb, text 16%, transparent)",
      "lineStrong": "color-mix(in srgb, text 30%, transparent)",
      "glow": "color-mix(in srgb, accentSoft 24%, transparent)",
      "glowStrong": "color-mix(in srgb, accentSoft 42%, transparent)",
      "ok": "hue-anchored: theme['meadow'].<mode>.accent, then AA blend (text >=4.5:1)",
      "error": "hue-anchored: theme['rose'].<mode>.accent, then AA blend (text >=4.5:1)",
      "warn": "hue-anchored: theme['ember'].<mode>.accent, then AA blend (text >=4.5:1)",
      "selection": "color-mix(in srgb, accentSoft 40%, bg)"
    },
    "com.tungstenskylark.roleNotes": {
      "bg": "page background",
      "surface": "cards, menus, raised panels",
      "text": "primary text (on bg)",
      "accent": "primary accent / CTAs \u2014 decorative in light mode when the raw brand value fails AA",
      "accentSoft": "soft accent, glows, highlights",
      "ink": "label colour ON accent (button text)",
      "accentText": "DERIVED role for text-bearing accent. Do NOT override accent. Values may be explicitly sanctioned or generated (WCAG-safe blend toward white/black).",
      "semantic": "Derived roles: ok/error/warn anchored to meadow/rose/ember accents per mode, AA-blended per theme background; selection = accentSoft 40% over bg. Emitted by build-tokens-css.py as --ts-ok/-error/-warn/-selection (+ -l/-d slots)."
    },
    "com.tungstenskylark.accentTextRuling": "Brand sign-off 2026-11 (@tungsten-skylark-studios, relayed via @ai): #9A5300 is THE text-bearing amber for skylark light mode (5.20:1 on #F5F2EC); #B26300 is large-text-only (>=18.7px bold / 24px, 3:1); brand ambers stay decorative (borders/glows). Dark mode needs no substitution (#FFB24D = 8.57:1)."
  },
